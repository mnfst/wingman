{
  "name": "wingman",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Postman for LLM APIs. A free, open-source browser tool to test OpenAI-compatible, OpenAI Responses, and Anthropic endpoints and read the raw request and response.",
  "homepage": "https://wingman.manifest.build",
  "repository": {
    "type": "git",
    "url": "https://github.com/mnfst/wingman"
  },
  "bugs": {
    "url": "https://github.com/mnfst/wingman/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write '{src,e2e}/**/*.{ts,tsx,js,css}' '*.{ts,json,mjs}'",
    "format:check": "prettier --check '{src,e2e}/**/*.{ts,tsx,js,css}' '*.{ts,json,mjs}'",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version:packages": "changeset version"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "highlight.js": "^11.11.1",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.62.1",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.7"
  }
}
